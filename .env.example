# Frame Fables LLC - Automation Backend
# Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# Notion CRM Configuration
# ============================================
# Create an integration at: https://www.notion.so/my-integrations
# Then share your database with the integration
NOTION_API_KEY=secret_your-notion-integration-token-here
NOTION_CRM_DATABASE_ID=your-notion-database-id-here

# ============================================
# Buffer API Configuration
# ============================================
# Get your access token from: https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your-buffer-access-token-here

# ============================================
# MailerLite API Configuration
# ============================================
# Get your API key from: https://www.mailerlite.com/integrations/api
MAILERLITE_API_KEY=your-mailerlite-api-key-here

# ============================================
# Application Configuration
# ============================================
# For local development, use: http://localhost:8000
# For Replit, use your Replit URL: https://your-project.repl.co
APP_BASE_URL=http://localhost:8000

# Port to run the application on
PORT=8000

# ============================================
# Typeform Configuration (Optional)
# ============================================
# Webhook secret for validating Typeform requests
# Get this from your Typeform webhook settings
TYPEFORM_WEBHOOK_SECRET=your-typeform-webhook-secret-here
