# Server Configuration
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/frame_fables?schema=public"

# Redis (for job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Pricing Tiers (in cents)
TIER_SQUIRE_PRICE=24999
TIER_KNIGHT_PRICE=49999
TIER_KING_PRICE=99999

# Social Media APIs (Optional - for future)
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
LINKEDIN_ACCESS_TOKEN=
TWITTER_API_KEY=

# Feature Flags
ENABLE_AUTO_PUBLISHING=false
ENABLE_ANALYTICS_SYNC=false
